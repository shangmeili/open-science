diff --git a/packages/opencode/test/session/system-context.test.ts b/packages/opencode/test/session/system-context.test.ts
new file mode 100644
index 0000000..795e702
--- /dev/null
+++ b/packages/opencode/test/session/system-context.test.ts
@@ -0,0 +1,37 @@
+import { describe, expect, it } from "bun:test"
+import { createHash } from "node:crypto"
+import {
+  fingerprintSystemContext,
+  MAX_SYSTEM_CONTEXT_BLOCKS,
+  SYSTEM_CONTEXT_CONTRACT,
+} from "../../src/session/llm/system-context"
+
+describe("system context audit fingerprint", () => {
+  it("is stable for the exact ordered system blocks", () => {
+    const system = ["first", "second\nline"]
+    expect(fingerprintSystemContext(system)).toEqual({
+      contract: SYSTEM_CONTEXT_CONTRACT,
+      sha256: createHash("sha256").update(JSON.stringify(system), "utf8").digest("hex"),
+      blockCount: 2,
+    })
+    expect(fingerprintSystemContext(system)).toEqual(fingerprintSystemContext([...system]))
+  })
+
+  it("changes when content, order, or block boundaries change", () => {
+    const baseline = fingerprintSystemContext(["alpha", "beta"]).sha256
+    expect(fingerprintSystemContext(["Alpha", "beta"]).sha256).not.toBe(baseline)
+    expect(fingerprintSystemContext(["beta", "alpha"]).sha256).not.toBe(baseline)
+    expect(fingerprintSystemContext(["alpha\nbeta"]).sha256).not.toBe(baseline)
+  })
+
+  it("never includes source content in the persisted value", () => {
+    const secret = "https://example.invalid/?token=research-secret"
+    expect(JSON.stringify(fingerprintSystemContext([secret]))).not.toContain(secret)
+  })
+
+  it("rejects an empty or unbounded system block list", () => {
+    expect(() => fingerprintSystemContext([])).toThrow(RangeError)
+    expect(fingerprintSystemContext(Array(MAX_SYSTEM_CONTEXT_BLOCKS).fill("system")).blockCount).toBe(1024)
+    expect(() => fingerprintSystemContext(Array(MAX_SYSTEM_CONTEXT_BLOCKS + 1).fill("system"))).toThrow(RangeError)
+  })
+})
