diff --git a/packages/opencode/src/session/llm/system-context.ts b/packages/opencode/src/session/llm/system-context.ts
new file mode 100644
index 0000000..065a8f1
--- /dev/null
+++ b/packages/opencode/src/session/llm/system-context.ts
@@ -0,0 +1,23 @@
+import { createHash } from "node:crypto"
+
+export const SYSTEM_CONTEXT_CONTRACT = "ai4heor.system-context/v1" as const
+export const MAX_SYSTEM_CONTEXT_BLOCKS = 1024
+
+export type SystemContextFingerprint = {
+  contract: typeof SYSTEM_CONTEXT_CONTRACT
+  sha256: string
+  blockCount: number
+}
+
+/** Content-free fingerprint of the exact ordered system blocks handed to the
+ * provider adapter after every system-transform plugin has run. */
+export function fingerprintSystemContext(system: readonly string[]): SystemContextFingerprint {
+  if (system.length < 1 || system.length > MAX_SYSTEM_CONTEXT_BLOCKS) {
+    throw new RangeError("system context block count is outside the audit contract")
+  }
+  return {
+    contract: SYSTEM_CONTEXT_CONTRACT,
+    sha256: createHash("sha256").update(JSON.stringify(system), "utf8").digest("hex"),
+    blockCount: system.length,
+  }
+}
